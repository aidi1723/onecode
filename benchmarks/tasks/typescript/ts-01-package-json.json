{
  "id": "ts-01-package-json",
  "prompt": "创建 TypeScript 项目 package.json 声明 ESM 模块",
  "expected_status": "completed",
  "mode": "agent",
  "input": {
    "max_turns": 4,
    "files": [],
    "script": [
      {
        "tool_name": "write_text",
        "params": {
          "path": "package.json",
          "content": "{\n  \"name\": \"@onecode/typed-service\",\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsc -b\",\n    \"test\": \"vitest run\"\n  }\n}\n"
        }
      }
    ]
  },
  "assertions": [
    {
      "type": "file_contains",
      "path": "package.json",
      "text": "\"type\": \"module\""
    },
    {
      "type": "file_contains",
      "path": "package.json",
      "text": "\"@onecode/typed-service\""
    }
  ]
}
