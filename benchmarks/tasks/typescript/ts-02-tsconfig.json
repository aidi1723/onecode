{
  "id": "ts-02-tsconfig",
  "prompt": "创建 tsconfig.json 开启严格类型检查",
  "expected_status": "completed",
  "mode": "agent",
  "input": {
    "max_turns": 4,
    "files": [],
    "script": [
      {
        "tool_name": "write_text",
        "params": {
          "path": "tsconfig.json",
          "content": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"NodeNext\",\n    \"moduleResolution\": \"NodeNext\",\n    \"strict\": true,\n    \"noImplicitAny\": true,\n    \"skipLibCheck\": true\n  },\n  \"include\": [\n    \"src/**/*\"\n  ]\n}\n"
        }
      }
    ]
  },
  "assertions": [
    {
      "type": "file_contains",
      "path": "tsconfig.json",
      "text": "\"strict\": true"
    },
    {
      "type": "file_contains",
      "path": "tsconfig.json",
      "text": "\"moduleResolution\": \"NodeNext\""
    }
  ]
}
