{
  "id": "rs-01-cargo-toml",
  "prompt": "创建 Cargo.toml 清单文件并配置元数据",
  "expected_status": "completed",
  "mode": "agent",
  "input": {
    "max_turns": 4,
    "files": [],
    "script": [
      {
        "tool_name": "write_text",
        "params": {
          "path": "Cargo.toml",
          "content": "[package]\nname = \"onecode-core\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\", \"rlib\"]\n"
        }
      }
    ]
  },
  "assertions": [
    {
      "type": "file_contains",
      "path": "Cargo.toml",
      "text": "name = \"onecode-core\""
    },
    {
      "type": "file_contains",
      "path": "Cargo.toml",
      "text": "edition = \"2021\""
    }
  ]
}
